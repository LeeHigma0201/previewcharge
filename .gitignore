# Virtual environments
.venv/
venv/
env/

# IDE
.vscode/
.idea/
*.swp
*.swo

# Environment / secrets
.env
.env.local
credentials.json

# Database
*.db
*.sqlite3

# Data files (large, not committed) — ignore contents but keep hand-curated
# meet-stats caches so the pipeline can rebuild the feature matrix on a fresh
# clone. Use /data/* (not /data/) so git will still recurse and respect the
# negations below.
/data/*
!/data/analysis/
/data/analysis/*
!/data/analysis/*.json
# Card-day folders (cd-YYYY-MM-DD): allow CSV + MD analysis artifacts to be
# committed so the PR shows the picks snapshot at deploy time. Raw scraped JSON
# stays ignored (regeneratable; may contain third-party data we shouldn't redist).
!/data/cd-*/
/data/cd-*/*
!/data/cd-*/*.csv
!/data/cd-*/*.md
!/data/cd-*/results.json
!/data/cd-*/algo-perf-summary.json
!/data/cd-*/r*-pool-snapshot.json

# Model artifacts
artifacts/
*.pkl
*.joblib
*.pt
*.pth

# Jupyter
.ipynb_checkpoints/

# MLflow
mlruns/

# Logs
*.log

# OS
.DS_Store
Thumbs.db

# Streamlit
.streamlit/secrets.toml

# Ruff / mypy
.ruff_cache/
.mypy_cache/
.vercel
.env*.local
